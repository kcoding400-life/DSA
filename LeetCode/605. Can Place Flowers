class Solution {
    public boolean canPlaceFlowers(int[] flowerbed, int n) {
        int length = flowerbed.length; // length of flowerbed
        for(int i=0; i<length; i++){
            // Check if current plot is empty
            if (flowerbed[i]==0){ 
                // Check left and right neighbors
                boolean emptyleft = (i==0) || (flowerbed[i - 1]==0);
                boolean emptyright = (i==length - 1) || (flowerbed[i + 1]==0);

                // If both neighbors are empty, plant here
                if(emptyleft && emptyright){
                    flowerbed[i]=1; // plant flower
                    n--; // one less flower to place
                    if (n==0) return true; // all flowers placed
                }
            }
        }
        return n <= 0; // true if all flowers placed
    }
}


Time Complexity: O(n) (single pass).
Space Complexity: O(1) (in-place planting).
