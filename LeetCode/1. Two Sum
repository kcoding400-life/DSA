import java.util.HashMap;
class Solution {
    public int[] twoSum(int[] nums, int target) {
        HashMap<Integer, Integer> map = new HashMap<>(); //Create a HashMap to store numbers and their indices       
        //Loop through the array
        for (int i = 0; i < nums.length; i++) {
            int complement = target - nums[i]; //Calculate the complement
            //If complement is already in map, we found a solution
            if (map.containsKey(complement)) {
                return new int[]{map.get(complement), i};// Return the indices
            }
            //Otherwise, store current number with its index in map
            map.put(nums[i], i);
        }
        throw new IllegalArgumentException("No two sum solution");
    }
}
