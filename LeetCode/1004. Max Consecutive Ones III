class Solution {
    public int longestOnes(int[] nums, int k) {
        int left = 0;
        int zeros = 0;
        int maxlength = 0;
        for(int right=0; right<nums.length;right++){
            if(nums[right]==0){
                zeros++;
            }
            // shrink window if more than k zeros
            while(zeros>k){
                if(nums[left]==0){
                    zeros--;
                }
                left++;
            }
            // window length is (right - left + 1)
            maxlength=Math.max(maxlength, right-left+1);
        }
        return maxlength;
    }
}

Complexity
Time: O(n) (each element processed once).
Space: O(1) (just counters and pointers).
