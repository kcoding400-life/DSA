class Solution {
    public int findNumbers(int[] nums) {
        int ct=0;
        for(int num: nums){
            int d = 0;
            while(num>0){
                num/=10;
                d++;
            }
            if(d%2==0){
                ct+=1;
            }
        }
        return ct;
    }
}
